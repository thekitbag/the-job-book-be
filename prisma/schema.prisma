generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         UserRole @default(PILOT)
  passwordHash String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  jobs                    Job[]
  reviewDecisions         ReviewDecision[]
  passwordResetTokens     PasswordResetToken[]
  uploadedPhotos          JobPhoto[]
  supportAuditEvents      SupportAuditEvent[]
  createdJobContacts      JobContact[]
  supplierAccountPayments SupplierAccountPayment[]
  workshopItems           WorkshopItem[]

  @@map("users")
}

// Job-local contacts: who is involved in one job (customer, building control,
// the electrician). Job context, not CRM — deliberately not global, not
// reusable across jobs, and never created from voice extraction. Soft-deleted
// so a removal stays auditable.
model JobContact {
  id              String    @id @default(uuid())
  jobId           String
  createdByUserId String
  name            String
  role            String?
  phone           String?
  email           String?
  note            String?
  sortOrder       Int       @default(0)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  deletedByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  job       Job  @relation(fields: [jobId], references: [id])
  createdBy User @relation(fields: [createdByUserId], references: [id])

  @@index([jobId, isDeleted, sortOrder])
  @@map("job_contacts")
}

model LabourPerson {
  id                        String   @id @default(uuid())
  jobId                     String
  name                      String
  normalizedName            String
  defaultHourlyRateAmount   String?
  defaultHourlyRateCurrency String?
  isArchived                Boolean  @default(false)
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId, normalizedName])
  @@index([jobId, isArchived])
  @@map("labour_people")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

enum UserRole {
  PILOT
  INTERNAL
}

model Job {
  id                    String    @id @default(uuid())
  ownerUserId           String
  title                 String
  jobType               String
  // A job Mike adds is running unless he says it is only being planned.
  // Kept in step with the API create default so seeds, scripts, and direct
  // Prisma creates cannot drift from product intent.
  status                JobStatus @default(STARTED)
  roughLocationOrLabel  String?
  siteAddress           String?
  notes                 String?
  customerTotalAmount   String?
  customerTotalCurrency String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  owner            User                @relation(fields: [ownerUserId], references: [id])
  rawNotes         RawNote[]
  candidateFacts   CandidateFact[]
  reviewDecisions  ReviewDecision[]
  memoryItems      MemoryItem[]
  queueItems       QueueItem[]
  budgetCategories JobBudgetCategory[]
  photos           JobPhoto[]
  payments         JobPayment[]
  moneyEvents      JobMoneyEvent[]
  labourPeople     LabourPerson[]
  contacts         JobContact[]
  workshopItems    WorkshopItem[]

  @@map("jobs")
}

// Money In/Out: actual money movement, kept distinct from Budget (committed
// cost). Customer payments stay in JobPayment (projected as Money in); this
// table holds the movements that are NOT customer payments — a merchant refund
// (REFUND/IN, linked to the returned material) and a marked-paid Budget cost
// (COST_PAID/OUT, linked to the paid item). Marking paid never mutates the
// source item or Budget totals. Soft-deletable for corrections.
enum JobMoneyDirection {
  IN
  OUT
}

enum JobMoneyKind {
  REFUND
  COST_PAID
}

model JobMoneyEvent {
  id                       String            @id @default(uuid())
  jobId                    String
  direction                JobMoneyDirection
  kind                     JobMoneyKind
  amount                   String
  currency                 String            @default("GBP")
  occurredAt               DateTime
  note                     String?
  reference                String?
  sourceMemoryItemId       String?
  // Set when this paid marker was written as part of ONE aggregate named-supplier
  // payment across jobs (supplier account settlement). Null for an ordinary
  // single mark-paid. Linked events keep working as normal paid markers for
  // Budget/paid-state, but job Money groups them into one visible allocation row
  // per job so an aggregate payment never double-counts.
  supplierAccountPaymentId String?
  isDeleted                Boolean           @default(false)
  deletedAt                DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt

  job                    Job                     @relation(fields: [jobId], references: [id])
  supplierAccountPayment SupplierAccountPayment? @relation(fields: [supplierAccountPaymentId], references: [id])

  @@index([jobId, occurredAt])
  @@index([jobId, isDeleted])
  @@index([jobId, sourceMemoryItemId])
  @@index([supplierAccountPaymentId])
  @@map("job_money_events")
}

// One real payment Mike made to one named supplier, covering whole recorded
// costs across several jobs. Durable and aggregate by design: the receipt,
// account payment history and Undo all hang off this row, so a settlement stays
// reconstructible after every covered cost has left the unpaid account list.
// It records what a payment covered — never bank reconciliation or a supplier
// statement match. Budget is untouched by settlement.
model SupplierAccountPayment {
  id              String    @id @default(uuid())
  ownerUserId     String
  supplierName    String
  amount          String
  currency        String    @default("GBP")
  paidAt          DateTime
  // Frontend-generated per submit; makes create idempotent under retries.
  clientRequestId String
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  owner       User            @relation(fields: [ownerUserId], references: [id])
  moneyEvents JobMoneyEvent[]

  @@unique([ownerUserId, clientRequestId])
  @@index([ownerUserId, supplierName, paidAt])
  @@index([ownerUserId, isDeleted, paidAt])
  @@map("supplier_account_payments")
}

enum JobStatus {
  PLANNING
  STARTED
  FINISHED
  ARCHIVED
}

model RawNote {
  id           String     @id @default(uuid())
  jobId        String
  clientNoteId String
  capturedAt   DateTime
  uploadedAt   DateTime   @default(now())
  mimeType     String
  durationMs   Int?
  sizeBytes    Int
  serverStatus NoteStatus @default(UPLOADED)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  job            Job             @relation(fields: [jobId], references: [id])
  audioObject    AudioObject?
  transcripts    Transcript[]
  candidateFacts CandidateFact[]
  linkedPhotos   JobPhoto[]

  @@unique([jobId, clientNoteId])
  @@map("raw_notes")
}

enum NoteStatus {
  UPLOADED
  QUEUED
  TRANSCRIBING
  TRANSCRIBED
  EXTRACTING
  EXTRACTED
  RECONCILING
  DONE
  FAILED
}

model AudioObject {
  id         String   @id @default(uuid())
  noteId     String   @unique
  storageKey String   @unique
  bucket     String
  mimeType   String
  sizeBytes  Int
  createdAt  DateTime @default(now())

  note RawNote @relation(fields: [noteId], references: [id])

  @@map("audio_objects")
}

model Transcript {
  id                   String           @id @default(uuid())
  noteId               String
  revision             Int              @default(1)
  status               TranscriptStatus @default(PENDING)
  text                 String?
  language             String?
  confidence           Float?
  provider             String?
  model                String?
  requestSchemaVersion String?
  providerResponseId   String?
  retryCount           Int              @default(0)
  errorCode            String?
  errorMessage         String?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  extractionStatus        ExtractionStatus?
  extractionProvider      String?
  extractionModel         String?
  extractionSchemaVersion String?
  extractionErrorCode     String?
  extractionErrorMessage  String?
  extractionStartedAt     DateTime?
  extractionCompletedAt   DateTime?

  note           RawNote         @relation(fields: [noteId], references: [id])
  candidateFacts CandidateFact[]

  @@map("transcripts")
}

enum TranscriptStatus {
  PENDING
  TRANSCRIBING
  COMPLETED
  FAILED
}

enum ExtractionStatus {
  PENDING
  EXTRACTING
  COMPLETED
  FAILED
}

enum FactType {
  ORDERED_MATERIAL
  USED_MATERIAL
  LEFTOVER_MATERIAL
  RETURNED_MATERIAL
  SUPPLIER_DELIVERY_NOTE
  CUSTOMER_CHANGE
  WATCH_OUT
  LABOUR
  BUDGET_COST
  GENERAL_NOTE
  UNCLEAR
}

enum CandidateFactStatus {
  DRAFT
  UNCLEAR
  CONFIRMED
  CORRECTED
  REJECTED
  SUPERSEDED
}

enum ConfidenceLabel {
  HIGH
  MEDIUM
  LOW
}

model CandidateFact {
  id                      String              @id @default(uuid())
  jobId                   String
  sourceNoteId            String
  sourceTranscriptId      String
  factType                FactType
  status                  CandidateFactStatus @default(DRAFT)
  summary                 String
  materialName            String?
  quantity                String?
  unit                    String?
  supplierName            String?
  deliveryTiming          String?
  locationOrUse           String?
  confidenceLabel         ConfidenceLabel
  confidenceReason        String
  uncertaintyFlags        String[]
  costAmount              String?
  costCurrency            String?
  costQualifier           String?
  totalCostAmount         String?
  labourHours             String?
  labourPerson            String?
  labourTask              String?
  happenedAt              DateTime?
  extractionProvider      String?
  extractionModel         String?
  extractionSchemaVersion String?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  job             Job              @relation(fields: [jobId], references: [id])
  sourceNote      RawNote          @relation(fields: [sourceNoteId], references: [id])
  transcript      Transcript       @relation(fields: [sourceTranscriptId], references: [id])
  reviewDecisions ReviewDecision[]
  memoryItems     MemoryItem[]

  @@map("candidate_facts")
}

enum ReviewDecisionAction {
  CONFIRM
  CORRECT
  REJECT
  CONFIRM_SECTION
  ADD_MISSING
  QUEUE_CONFIRM
  QUEUE_CORRECT
  QUEUE_DISMISS
}

model ReviewDecision {
  id                     String               @id @default(uuid())
  jobId                  String
  decidedBy              String
  action                 ReviewDecisionAction
  candidateFactId        String?
  sectionKey             String?
  reason                 String?
  sourceCandidateFactIds String[]             @default([])
  createdAt              DateTime             @default(now())

  job           Job            @relation(fields: [jobId], references: [id])
  user          User           @relation(fields: [decidedBy], references: [id])
  candidateFact CandidateFact? @relation(fields: [candidateFactId], references: [id])
  memoryItems   MemoryItem[]

  @@map("review_decisions")
}

model MemoryItem {
  id                       String    @id @default(uuid())
  jobId                    String
  reviewDecisionId         String
  sourceCandidateFactId    String?
  memoryType               FactType
  isManual                 Boolean   @default(false)
  summary                  String
  materialName             String?
  quantity                 String?
  unit                     String?
  supplierName             String?
  deliveryTiming           String?
  locationOrUse            String?
  costAmount               String?
  costCurrency             String?
  costQualifier            String?
  totalCostAmount          String?
  labourHours              String?
  labourPerson             String?
  labourTask               String?
  // Labour people + per-entry Budget rules. labourPersonId links a labour entry
  // to a lightweight LabourPerson. labourBudgetEnabled === true means this entry
  // may contribute to Budget when it has trusted GBP cost; false = hours-only
  // (never Budget cost, even if a rate is stored for reference); null is a
  // legacy/migration-only state treated conservatively as not-budget.
  labourPersonId           String?
  labourBudgetEnabled      Boolean?
  happenedAt               DateTime?
  unresolvedFlags          String[]  @default([])
  budgetCategoryId         String?
  isRemoved                Boolean   @default(false)
  removedAt                DateTime?
  removedByUserId          String?
  removedReason            String?
  // Returned materials: a RETURNED_MATERIAL item records the returned quantity
  // (quantity/unit), merchant (supplierName), and — separate from spend cost
  // fields — a trusted refund. returnedFromMemoryItemId is a soft string link
  // back to the source Left over item (no FK; v1 traceability only).
  returnedFromMemoryItemId String?
  refundAmount             String?
  refundCurrency           String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  job            Job                @relation(fields: [jobId], references: [id])
  reviewDecision ReviewDecision     @relation(fields: [reviewDecisionId], references: [id])
  sourceFact     CandidateFact?     @relation(fields: [sourceCandidateFactId], references: [id])
  budgetCategory JobBudgetCategory? @relation(fields: [budgetCategoryId], references: [id])
  linkedPhotos   JobPhoto[]
  workshopItems  WorkshopItem[]

  @@index([jobId, budgetCategoryId])
  @@index([jobId, isRemoved])
  @@map("memory_items")
}

model JobBudgetCategory {
  id             String   @id @default(uuid())
  jobId          String
  name           String
  budgetAmount   String?
  budgetCurrency String?
  sortOrder      Int      @default(0)
  isArchived     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  job         Job          @relation(fields: [jobId], references: [id])
  memoryItems MemoryItem[]

  @@index([jobId, sortOrder])
  @@map("job_budget_categories")
}

// Job evidence classification. `kind` follows Mike's intent at upload time,
// not the file format: an image uploaded through "Add receipt or invoice" is
// RECEIPT and must never surface in the Photos list. Existing rows default to
// PHOTO so nothing is silently reclassified.
enum JobEvidenceKind {
  PHOTO
  RECEIPT
}

enum JobEvidenceFileKind {
  IMAGE
  PDF
}

// Job evidence: photos (kind PHOTO) and receipts/invoices (kind RECEIPT) share
// this table and the private object-storage path. The table name stays
// `job_photos` for compatibility.
model JobPhoto {
  id                 String              @id @default(uuid())
  jobId              String
  uploadedByUserId   String
  kind               JobEvidenceKind     @default(PHOTO)
  fileKind           JobEvidenceFileKind @default(IMAGE)
  descriptor         String?
  originalFileName   String?
  storageKey         String              @unique
  bucket             String
  mimeType           String
  sizeBytes          Int
  linkedNoteId       String?
  linkedMemoryItemId String?
  isDeleted          Boolean             @default(false)
  deletedAt          DateTime?
  deletedByUserId    String?
  uploadedAt         DateTime            @default(now())
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  job              Job         @relation(fields: [jobId], references: [id])
  uploadedBy       User        @relation(fields: [uploadedByUserId], references: [id])
  linkedNote       RawNote?    @relation(fields: [linkedNoteId], references: [id])
  linkedMemoryItem MemoryItem? @relation(fields: [linkedMemoryItemId], references: [id])

  @@index([jobId, uploadedAt])
  @@index([jobId, linkedNoteId])
  @@index([jobId, linkedMemoryItemId])
  @@index([jobId, isDeleted])
  @@index([jobId, kind, isDeleted])
  @@map("job_photos")
}

model JobPayment {
  id        String    @id @default(uuid())
  jobId     String
  amount    String
  currency  String    @default("GBP")
  paidAt    DateTime
  note      String?
  reference String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId, paidAt])
  @@index([jobId, isDeleted])
  @@map("job_payments")
}

model SupportAuditEvent {
  id           String   @id @default(uuid())
  adminUserId  String
  targetUserId String?
  targetJobId  String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())

  adminUser User @relation(fields: [adminUserId], references: [id])

  @@index([adminUserId, createdAt])
  @@index([targetJobId, createdAt])
  @@map("support_audit_events")
}

model QueueItem {
  id                     String   @id @default(uuid())
  jobId                  String
  sectionKey             String
  kind                   String
  status                 String   @default("draft")
  reviewLabel            String
  timeLabel              String?
  summary                String
  proposedMemory         Json
  confidenceLabel        String   @default("medium")
  uncertaintyFlags       String[]
  sourceCandidateFactIds String[]
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id])

  @@index([jobId])
  @@map("queue_items")
}

// Workshop: availability memory over real leftovers, not inventory and not
// finance. A WorkshopItem is the CURRENT availability state of material Mike
// thinks may still be in the workshop — either linked to a confirmed
// `leftover_material` memory item in a job (sourceKind LEFTOVER) or added by
// hand with no source (sourceKind MANUAL).
//
// Deliberately a separate record rather than a flag on MemoryItem: the source
// memory item stays untouched evidence (purchase, cost, paid state, job
// status), so no Workshop action can move Budget or Money. Every source-side
// Workshop state in read models is DERIVED from this row, so there is no second
// copy to fall out of step and a failed action cannot leave the two disagreeing.
//
// One row per source leftover for its whole life: moving again after an undo or
// a terminal outcome reactivates the same row rather than creating a second
// availability record. A partial unique index (see the migration) enforces at
// most one AVAILABLE row per source memory item.
//
// `roughAmount` is free text ("about half a box"). Never parsed, normalised,
// totalled or sharpened — blank is a valid answer, not missing data.
enum WorkshopItemState {
  AVAILABLE
  USED_UP
  WASNT_THERE
  MOVED_BACK
}

enum WorkshopItemSourceKind {
  LEFTOVER
  MANUAL
}

model WorkshopItem {
  id                 String                 @id @default(uuid())
  ownerUserId        String
  materialName       String
  roughAmount        String?
  sourceKind         WorkshopItemSourceKind
  sourceJobId        String?
  sourceMemoryItemId String?
  state              WorkshopItemState      @default(AVAILABLE)
  enteredWorkshopAt  DateTime
  resolvedAt         DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  owner            User        @relation(fields: [ownerUserId], references: [id])
  sourceJob        Job?        @relation(fields: [sourceJobId], references: [id])
  sourceMemoryItem MemoryItem? @relation(fields: [sourceMemoryItemId], references: [id])

  @@index([ownerUserId, state, enteredWorkshopAt])
  @@index([sourceJobId, sourceMemoryItemId])
  @@map("workshop_items")
}
